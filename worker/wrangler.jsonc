{
  "name": "indexator",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "kv_namespaces": [
    {
      "binding": "SNAPSHOTS",
      "id": "377007ae7840409eb47e2a2d389aca22"
    }
  ],
  "triggers": {
    "crons": [
      "*/10 * * * *"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": false,
      "head_sampling_rate": 1,
      "persist": true
    },
    "issue_detection": {
      "enabled": false
    }
  }
}